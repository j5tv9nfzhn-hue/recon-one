{
  "version": 1,
  "note": "定向内容发现的候选来源。不是字典：只放已识别技术栈的少量已知入口、常见运维/API 根路径，以及从目标自身 JS 端点推导出的目录前缀。每条候选都必须经过 404/软 404 基线比对。",
  "max_candidates": 200,
  "common": [
    "/api/",
    "/health",
    "/healthz",
    "/ready",
    "/status",
    "/metrics",
    "/docs",
    "/redoc",
    "/swagger-ui/",
    "/actuator",
    "/admin/",
    "/login"
  ],
  "tech": {
    "apache": ["/server-status", "/server-info"],
    "nginx": ["/nginx_status"],
    "iis": ["/iisstart.htm", "/trace.axd"],
    "tomcat": ["/manager/html", "/host-manager/html"],
    "spring boot": ["/actuator", "/actuator/health", "/actuator/env", "/v2/api-docs", "/v3/api-docs"],
    "swagger ui": ["/swagger-ui/", "/swagger-ui/index.html", "/swagger-resources"],
    "wordpress": ["/wp-admin/", "/wp-login.php", "/wp-json/"],
    "drupal": ["/user/login", "/core/install.php"],
    "joomla": ["/administrator/"],
    "magento": ["/admin/", "/rest/V1/"],
    "django": ["/admin/", "/api/", "/docs/"],
    "flask": ["/api/", "/health", "/docs"],
    "express": ["/api/", "/health", "/metrics"],
    "laravel": ["/api/", "/login", "/admin/"],
    "rails": ["/api/", "/admin/", "/rails/info/routes"],
    "keycloak": ["/auth/realms/master", "/admin/", "/.well-known/openid-configuration"],
    "next.js": ["/_next/", "/api/"],
    "nuxt": ["/_nuxt/", "/api/"],
    "grafana": ["/login", "/api/health"],
    "kibana": ["/app/kibana", "/status"],
    "jenkins": ["/manage", "/api/json"],
    "gitlab": ["/users/sign_in", "/-/health"],
    "prometheus": ["/graph", "/-/healthy"],
    "phpmyadmin": ["/phpmyadmin/", "/pma/"],
    "adminer": ["/adminer.php"],
    "portainer": ["/api/status"]
  }
}
