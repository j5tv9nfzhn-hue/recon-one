{
 "version": 1,
 "note": "Patterns only ever produce a redacted value in the report; full value stays in raw/.",
 "patterns": [
  {"name": "aws_access_key_id", "severity": "high", "regex": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b", "min_len": 20},
  {"name": "google_api_key", "severity": "high", "regex": "\\bAIza[0-9A-Za-z_\\-]{35}\\b", "min_len": 35},
  {"name": "gcp_service_account", "severity": "high", "regex": "\"type\"\\s*:\\s*\"service_account\"", "min_len": 20},
  {"name": "stripe_secret_key", "severity": "high", "regex": "\\bsk_live_[0-9A-Za-z]{20,}\\b", "min_len": 24},
  {"name": "github_token", "severity": "high", "regex": "\\bgh[pousr]_[0-9A-Za-z]{36,}\\b", "min_len": 36},
  {"name": "gitlab_token", "severity": "high", "regex": "\\bglpat-[0-9A-Za-z_\\-]{20,}\\b", "min_len": 26},
  {"name": "slack_token", "severity": "high", "regex": "\\bxox[baprs]-[0-9A-Za-z\\-]{10,}\\b", "min_len": 15},
  {"name": "sendgrid_key", "severity": "high", "regex": "\\bSG\\.[0-9A-Za-z_\\-]{16,}\\.[0-9A-Za-z_\\-]{32,}\\b", "min_len": 50},
  {"name": "twilio_key", "severity": "high", "regex": "\\bSK[0-9a-fA-F]{32}\\b", "min_len": 34},
  {"name": "npm_token", "severity": "high", "regex": "\\bnpm_[0-9A-Za-z]{36}\\b", "min_len": 40},
  {"name": "private_key_block", "severity": "critical", "regex": "-----BEGIN (?:RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----", "min_len": 30},
  {"name": "jwt", "severity": "medium", "regex": "\\beyJ[A-Za-z0-9_\\-]{10,}\\.eyJ[A-Za-z0-9_\\-]{10,}\\.[A-Za-z0-9_\\-]{10,}\\b", "min_len": 40},
  {"name": "aws_secret_like", "severity": "medium", "regex": "(?:aws_?secret|SecretAccessKey)[\"']?\\s*[:=]\\s*[\"'][0-9A-Za-z/+=]{32,}[\"']", "group": 0, "min_len": 40},
  {"name": "azure_storage_key", "severity": "high", "regex": "AccountKey=[0-9A-Za-z+/=]{40,}", "min_len": 50},
  {"name": "basic_auth_url", "severity": "high", "regex": "https?://[^\\s:/@]{1,40}:[^\\s/@]{1,60}@[^\\s'\"]{3,}", "min_len": 12},
  {"name": "firebase_database", "severity": "medium", "regex": "https://[a-z0-9\\-]+\\.firebaseio\\.com", "min_len": 25},
  {"name": "s3_bucket_url", "severity": "low", "regex": "https?://[a-z0-9.\\-]{3,63}\\.s3[.\\-][a-z0-9\\-]*\\.?amazonaws\\.com", "min_len": 25}
 ]
}
